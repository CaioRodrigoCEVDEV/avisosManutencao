NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://usuario:senha@localhost:5432/maintenance_api

JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRES_IN=8h
COOKIE_NAME=maintenance_auth

# Origens permitidas separadas por vírgula (sem "*" quando há credenciais)
CORS_ORIGIN=http://localhost:3000,https://avisos.orderup.com.br

# Fuso usado para converter data/hora informados no painel
APP_TIMEZONE=America/Sao_Paulo

# Confiança no proxy reverso (Apache/Nginx). Padrão: 1 em produção, false fora.
# Pode ser true, false ou um número de hops.
# TRUST_PROXY=1

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123
